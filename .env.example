APP_NAME=knowledge-base
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/knowledge_base.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_FOLDER_DEPTH=10
RECYCLE_BIN_RETENTION_DAYS=90

JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# Comma-separated usernames to promote to administrators during database initialization.
ADMIN_USERNAMES=admin

# MCP is a separate read-only stdio process.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8020
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
# Copy the access_token returned by login/register here before starting MCP.
# For streamable-http, send the token in the remote client's Authorization header.
KB_MCP_TOKEN=
MCP_MAX_CONTENT_CHARS=30000

# Standalone Agent REST API: development 9030, production 8030.
REST_API_HOST=0.0.0.0
REST_API_PORT=9030
# Set a routable IP or HTTPS domain for remote OAuth clients.
REST_API_PUBLIC_URL=
REST_API_PUBLIC_SCHEME=http
REST_API_OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
REST_API_OAUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
REST_API_OAUTH_SESSION_EXPIRE_DAYS=30
REST_API_OAUTH_COOKIE_SECURE=false
